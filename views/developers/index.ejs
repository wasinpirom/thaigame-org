<%- include("../partials/head",{metaTitle,metaDescription}) %><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">คนเบื้องหลังเกมไทย</span><h1>นักพัฒนาและทีมงาน</h1><p>สมาชิกที่เลือกเปิดโปรไฟล์สาธารณะ พร้อมผลงานและช่องทางติดต่อ</p></div></section><section class="section"><div class="container"><% if(developers.length){ %><div class="dev-grid"><% developers.forEach(d=>{ %><article><a class="dev-avatar" href="/developers/<%= d.id %>"><% if(d.avatar_path){ %><img src="<%= d.avatar_path %>" alt=""><% }else{ %><span><%= d.display_name[0] %></span><% } %></a><div><span class="tag">โปรไฟล์สาธารณะ</span><h2><a href="/developers/<%= d.id %>"><%= d.display_name %></a></h2><p><%= excerpt(d.bio,140)||"สมาชิกชุมชนผู้สร้างเกมไทย" %></p><strong><%= d.game_count %> ผลงาน · <a href="/developers/<%= d.id %>">ดูโปรไฟล์ →</a></strong></div></article><% }) %></div><% }else{ %><div class="empty"><h2>ยังไม่มีโปรไฟล์สาธารณะ</h2></div><% } %></div></section></main><%- include("../partials/footer") %>
