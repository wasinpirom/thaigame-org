<%- include("../partials/head",{metaTitle,metaDescription,metaImage,noindex}) %><main id="main"><article class="article"><div class="container article__wrap"><% if(isAdmin){ %><div class="admin-bar"><span class="status status--<%= article.status %>"><%= {pending:"รออนุมัติ",published:"เผยแพร่แล้ว",rejected:"ไม่อนุมัติ"}[article.status] %></span><a class="btn btn--outline btn--sm" href="/admin/news/<%= article.id %>/edit">แก้ไข</a><% if(article.status!=="published"){ %><form method="post" action="/admin/news/<%= article.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="published"><input type="hidden" name="back" value="/admin/news"><button class="btn btn--gold btn--sm">อนุมัติและเผยแพร่</button></form><% } %></div><% } %><nav class="crumbs"><a href="/news">ข่าว</a> › <a href="<%= article.kind==='video'?'/videos':article.kind==='course'?'/learn':'/news?kind='+article.kind %>"><%= newsKinds[article.kind]?newsKinds[article.kind].label:'' %></a></nav><h1><%= article.title %></h1><p class="article__lead"><%= article.excerpt %></p><div class="article__meta"><span><%= formatDate(article.published_at||article.created_at) %></span><% if(article.source_name||article.provider){ %><span>ที่มา: <%= article.provider||article.source_name %></span><% } %><span>◉ <%= Number(article.views||0).toLocaleString("th-TH") %></span></div><% if(article.video_id){ %><div class="video-frame"><iframe src="https://www.youtube-nocookie.com/embed/<%= article.video_id %>" title="<%= article.title %>" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div><% }else if(article.image_url){ %><figure class="article__img"><img src="<%= article.image_url %>" alt="" referrerpolicy="no-referrer"></figure><% } %><% if(!article.video_id&&!article.image_url){ %><figure class="article__img"><%- include("../partials/text-cover",{title:article.title,kind:article.kind,size:"wide"}) %></figure><% } %><div class="article__body"><%- renderBody(article.body) %></div><% if(article.source_url){ %><div class="source-box"><div><strong><%= article.kind==='course'?'ไปที่คอร์ส / แหล่งเรียนรู้':article.kind==='thai_game'?'ดูเกมและติดตามผู้สร้าง':'อ่านต้นฉบับ' %></strong><small><%= article.provider||article.source_name||new URL(article.source_url).hostname %></small></div><a class="btn btn--gold" href="<%= article.source_url %>" target="_blank" rel="noopener nofollow"><%= article.kind==='course'?'ดูคอร์ส ↗':article.kind==='video'?'ดูบน YouTube ↗':'ไปที่ต้นทาง ↗' %></a></div><% } %><% if(article.ai_generated){ %><p class="ai-disclosure">บทความนี้เรียบเรียงด้วย AI (<%= article.ai_model||'LLM' %>) จากข้อมูลต้นทาง และผ่านการตรวจโดยบรรณาธิการ ThaiGame.org หากพบข้อผิดพลาดแจ้งได้ที่ LINE OA <a href="<%= lineOaUrl %>" target="_blank" rel="noopener"><%= lineOaId %></a></p><% } %><div class="article__ad"><%- include("../partials/kway-banner") %></div><% if(related.length){ %><h2 class="related-title">ข่าวที่เกี่ยวข้อง</h2><div class="news-grid news-grid--4"><% related.forEach(a=>{ %><%- include("../partials/news-card",{a}) %><% }) %></div><% } %></div></article></main><%- include("../partials/footer",{hideAd:true}) %>
