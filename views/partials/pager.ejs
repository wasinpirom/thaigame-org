<% if(pages>1){ const qs=(n)=>{const u=new URLSearchParams(typeof params!=="undefined"?params:{});u.set("page",n);return "?"+u.toString();}; %><nav class="pager" aria-label="หน้า"><% if(page>1){ %><a class="btn btn--outline btn--sm" href="<%= qs(page-1) %>">← ใหม่กว่า</a><% } %><span>หน้า <%= page %> / <%= pages %></span><% if(page<pages){ %><a class="btn btn--outline btn--sm" href="<%= qs(page+1) %>">เก่ากว่า →</a><% } %></nav><% } %>
