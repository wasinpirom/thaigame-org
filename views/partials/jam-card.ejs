<% const st=jamHelpers.jamState(j); %><article class="jam-card jam-card--<%= st.key %><%= j.is_thai?' jam-card--thai':'' %>"><a class="jam-card__img" href="<%= j.url %>" target="_blank" rel="noopener"><% if(j.image_url){ %><img src="<%= j.image_url %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% }else{ %><span>JAM</span><% } %><span class="jam-state"><%= st.key==='running'?'● ':'' %><%= st.label %></span><% if(j.is_thai){ %><span class="jam-thai">🇹🇭 ไทย</span><% } %></a><div class="jam-card__body"><h3><a href="<%= j.url %>" target="_blank" rel="noopener"><%= j.title %></a></h3><p class="jam-count" data-countdown="<%= st.key==='ended'?'':new Date(st.until).toISOString() %>" data-prefix="<%= st.key==='running'?'จบใน':'เริ่มใน' %>"><%= st.key==='running'?'จบใน':st.key==='upcoming'?'เริ่มใน':'จบแล้ว' %> <% if(st.key!=='ended'){ %><b><%= jamHelpers.relDays(st.until) %></b><% } %></p><div class="jam-meta"><span>🗓 <%= jamHelpers.bkk(j.start_at,{day:'numeric',month:'short'}) %><%= j.end_at?' – '+jamHelpers.bkk(j.end_at,{day:'numeric',month:'short'}):'' %></span><% if(j.joined){ %><span>👥 <%= Number(j.joined).toLocaleString('th-TH') %> คน</span><% } %></div></div></article>
