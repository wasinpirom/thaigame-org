<article class="news-card news-card--<%= a.kind %>"><a class="news-card__img" href="/news/<%= a.slug %>"><% if(a.image_url){ %><img src="<%= a.image_url %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% }else{ %><%- include("text-cover",{title:a.title,kind:a.kind}) %><% } %><% if(a.video_id){ %><span class="news-card__play">▶</span><% } %></a><div class="news-card__body"><div class="tags"><span><%= newsKinds[a.kind]?newsKinds[a.kind].short:a.kind %></span><% if(a.ai_generated){ %><span class="tag--ai">AI</span><% } %><% if(a.featured){ %><span class="tag--hot">แนะนำ</span><% } %></div><h3><a href="/news/<%= a.slug %>"><%= a.title %></a></h3><p><%= excerpt(a.excerpt,130) %></p><div class="news-card__meta"><span><%= a.provider||a.source_name %></span><span><%= ago(a.published_at||a.created_at) %></span></div></div></article>
