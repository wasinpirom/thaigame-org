<% const isEnglish=currentPath.startsWith("/en"); const cleanPath=currentPath.replace(/^\/en(?=\/|$)/,"")||"/"; const publicLangPath=cleanPath==="/"||cleanPath==="/games"||cleanPath.startsWith("/games/")||cleanPath==="/developers"||cleanPath.startsWith("/developers/")||cleanPath==="/events"||cleanPath.startsWith("/events/")||cleanPath==="/about"||cleanPath==="/terms"||cleanPath==="/register"||cleanPath==="/login"; const langHref=isEnglish?cleanPath:(publicLangPath?("/en"+(currentPath==="/"?"":currentPath)):"/en"); %><header class="header"><div class="container header__in"><a class="brand" href="<%= isEnglish?'/en':'/' %>"><span class="brand__mark">◇</span><span>ThaiGame.org</span></a><nav id="nav" class="nav"><a href="<%= isEnglish?'/en/games':'/games' %>"><%= isEnglish?'Games':'ค้นหาเกม' %></a><a href="<%= isEnglish?'/en/developers':'/developers' %>"><%= isEnglish?'Creators':'นักพัฒนา' %></a><a href="<%= isEnglish?'/en/events':'/events' %>"><%= isEnglish?'Events':'กิจกรรม' %></a><a href="<%= isEnglish?'/en/about':'/about' %>"><%= isEnglish?'About':'เกี่ยวกับเรา' %></a><% if(currentUser){ %><a href="/dashboard"><%= isEnglish?'My games':'ผลงานของฉัน' %></a><% if(currentUser.role==="admin"){ %><a href="/admin"><%= isEnglish?'Admin':'แอดมิน' %></a><% } %><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit"><%= isEnglish?'Sign out':'ออกจากระบบ' %></button></form><% }else{ %><a href="<%= isEnglish?'/en/login':'/login' %>"><%= isEnglish?'Sign in':'เข้าสู่ระบบ' %></a><% } %><a class="btn btn--gold btn--sm" href="<%= currentUser?'/games/new':(isEnglish?'/en/register':'/register') %>"><%= currentUser?(isEnglish?'Add game':'เพิ่มผลงานเกม'):(isEnglish?'Join and add game':'สมัครและเพิ่มเกม') %></a></nav><div class="header__actions"><a class="lang-switch" href="<%= langHref %>" lang="<%= isEnglish?'th':'en' %>"><span><%= isEnglish?'TH':'ENG' %></span></a><button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav">☰</button></div></div></header>
