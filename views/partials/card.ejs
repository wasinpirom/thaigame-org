<article class="game-card"><a class="game-card__cover" href="/games/<%= game.slug %>"><% if(game.cover_path){ %><img src="<%= game.cover_path %>" alt="ภาพปก <%= game.title_th %>" loading="lazy"><% }else{ %><span class="placeholder">TG</span><% } %><% if(game.featured){ %><span class="featured">แนะนำ</span><% } %></a><div class="game-card__body"><div class="tags"><% game.categories.slice(0,2).forEach(k=>{if(categories[k]){ %><span><%= categories[k].short %></span><% }}); %></div><h3><a href="/games/<%= game.slug %>"><%= game.title_th %></a></h3><% if(game.title_en){ %><small><%= game.title_en %></small><% } %><p><%= excerpt(game.short_description,115) %></p><div class="game-card__meta"><span><%= game.developer_name||(game.profile_public?game.owner_name:"ไม่เปิดเผยโปรไฟล์") %></span><span>◉ <%= Number(game.views||0).toLocaleString("th-TH") %></span></div></div></article>
