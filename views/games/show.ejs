<%- include("../partials/head",{metaTitle,metaDescription,metaImage:game.cover_path}) %><main id="main"><% if(game.status==="hidden"){ %><div class="moderation"><div class="container"><strong>ผลงานนี้ถูกซ่อนจากสาธารณะ</strong> <%= game.admin_note %></div></div><% } %><section class="game-hero"><div class="container game-hero__grid"><div class="big-cover"><% if(game.cover_path){ %><img src="<%= game.cover_path %>" alt="ภาพปก <%= game.title_th %>"><% }else{ %><span class="placeholder">TG</span><% } %></div><div><div class="tags"><% game.categories.forEach(k=>{if(categories[k]){ %><a href="/games?category=<%= k %>"><%= categories[k].label %></a><% }}); %><% if(game.ai_usage){ %><span class="tag--ai">AI disclosure</span><% } %></div><h1><%= game.title_th %></h1><% if(game.title_en){ %><p class="title-en"><%= game.title_en %></p><% } %><p class="lead"><%= game.short_description %></p><dl class="facts"><div><dt>ผู้พัฒนา</dt><dd><%= game.developer_name||(game.profile_public?game.owner_name:"ไม่เปิดเผยชื่อทีม") %></dd></div><div><dt>แพลตฟอร์ม</dt><dd><%= game.platforms.join(" · ") %></dd></div><% if(game.release_date){ %><div><dt>วางจำหน่าย</dt><dd><%= formatDate(game.release_date) %></dd></div><% } %><div><dt>เข้าชม</dt><dd><%= game.views %> ครั้ง</dd></div></dl><div class="actions"><% game.links.forEach((l,i)=>{ %><a class="btn <%= i?"btn--outline":"btn--gold" %>" href="<%= l.url %>" target="_blank" rel="noopener nofollow"><%= l.label %> ↗</a><% }) %></div><small>ลิงก์เปิดเว็บไซต์ภายนอก กรุณาตรวจสอบก่อนซื้อหรือดาวน์โหลด</small><% if(canManage){ %><p><a class="edit-link" href="/games/<%= game.slug %>/edit">✎ แก้ไขผลงานนี้</a></p><% } %></div></div></section>
<section class="section"><div class="container detail-grid"><article class="panel"><span class="eyebrow">เกี่ยวกับเกม</span><h2>รายละเอียดผลงาน</h2><div class="prose"><% game.description.split(/\n+/).forEach(p=>{ %><p><%= p %></p><% }) %></div><% if(game.ai_usage){ %><div class="ai-disclosure"><strong>การใช้ AI ในผลงานนี้</strong><p><%= game.ai_usage %></p></div><% } %></article><aside class="panel identity"><% if(owner){ %><div class="identity__head"><% if(owner.avatar_path){ %><img src="<%= owner.avatar_path %>" alt=""><% }else{ %><span><%= owner.display_name[0] %></span><% } %><div><small>เจ้าของผลงาน</small><h2><%= owner.display_name %></h2></div></div><p><%= excerpt(owner.bio,180) %></p><div class="contacts"><% if(owner.contact_email){ %><a href="mailto:<%= owner.contact_email %>">อีเมล <strong><%= owner.contact_email %></strong></a><% } %><% if(owner.line_id){ %><div>LINE ID <strong><%= owner.line_id %></strong></div><% } %><% if(owner.phone){ %><a href="tel:<%= owner.phone %>">โทรศัพท์ <strong><%= owner.phone %></strong></a><% } %></div><a class="btn btn--outline btn--block" href="/developers/<%= owner.id %>">ดูผลงานทั้งหมด</a><% }else{ %><div class="privacy">●</div><h2>เจ้าของผลงานไม่เปิดเผยโปรไฟล์</h2><p>ยังดูเกมและใช้ลิงก์ที่เจ้าของระบุได้ตามปกติ</p><% } %></aside></div></section>
<% if(game.screenshots.length){ %><section class="section section--white"><div class="container"><div class="heading"><h2>Screenshot</h2><span><%= game.screenshots.length %> ภาพ</span></div><div class="shots"><% game.screenshots.forEach((s,i)=>{ %><button data-lightbox="<%= s.path %>"><img src="<%= s.path %>" alt="Screenshot <%= i+1 %>"></button><% }) %></div></div></section><% } %><% if(game.videos.length){ %><section class="section"><div class="container"><h2>วิดีโอจาก YouTube</h2><div class="videos"><% game.videos.forEach(v=>{ %><iframe src="https://www.youtube.com/embed/<%= v.youtube_id %>" title="วิดีโอ <%= game.title_th %>" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe><% }) %></div></div></section><% } %></main><div class="lightbox" hidden><button data-lightbox-close>×</button><img alt="Screenshot ขนาดใหญ่"></div><%- include("../partials/footer") %>
