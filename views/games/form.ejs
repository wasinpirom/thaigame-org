<%- include("../partials/head",{metaTitle,noindex:true}) %><main id="main" class="form-page"><section class="page-hero page-hero--compact"><div class="container"><span class="eyebrow"><%= mode==="create"?"แบ่งปันผลงานของคุณ":"จัดการผลงาน" %></span><h1><%= mode==="create"?"เพิ่มผลงานเกม":"แก้ไข "+game.title_th %></h1><p>ThaiGame.org เก็บเฉพาะข้อมูลและภาพประชาสัมพันธ์ ไฟล์เกมต้องอยู่บนเว็บไซต์ภายนอก</p></div></section><section class="section"><div class="container form-layout"><div><%- include("../partials/errors",{errors}) %><form class="stack" method="post" enctype="multipart/form-data" action="<%= mode==='create'?'/games/new':'/games/'+game.slug+'/edit' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<section class="form-card"><div class="form-title"><span>01</span><div><h2>ข้อมูลหลักของเกม</h2><p>เขียนให้ผู้เล่นเข้าใจเสน่ห์ของเกมได้รวดเร็ว</p></div></div><div class="fields"><label>ชื่อเกมภาษาไทย *<input name="title_th" value="<%= form.title_th||'' %>" required maxlength="140"></label><label>ชื่อภาษาอังกฤษ<input name="title_en" value="<%= form.title_en||'' %>" maxlength="140"></label><label class="full">คำโปรยสั้น *<textarea name="short_description" rows="2" required maxlength="220"><%= form.short_description||'' %></textarea><small>20–220 ตัวอักษร</small></label><label class="full">รายละเอียดเกม *<textarea name="description" rows="8" required maxlength="12000"><%= form.description||'' %></textarea><small>แนวเกม วิธีเล่น เรื่องราว ทีมงาน หรือรางวัล</small></label><label>ชื่อทีม/ผู้พัฒนา<input name="developer_name" value="<%= form.developer_name||'' %>" maxlength="140"></label><label>วันที่วางจำหน่าย<input type="date" name="release_date" value="<%= form.release_date||'' %>"></label></div></section>
<section class="form-card"><div class="form-title"><span>02</span><div><h2>หมวดและแพลตฟอร์ม</h2><p>เลือกได้มากกว่า 1 รายการ</p></div></div><fieldset><legend>เกมนี้เป็นเกมไทยในลักษณะใด *</legend><div class="choices"><% Object.entries(categories).forEach(([k,c])=>{ %><label><input type="checkbox" name="categories" value="<%= k %>" <%= (form.categories||[]).includes(k)?"checked":"" %>><span><strong><%= c.label %></strong><small><%= c.desc %></small></span></label><% }) %></div></fieldset><fieldset><legend>แพลตฟอร์ม *</legend><div class="pills"><% platformOptions.forEach(p=>{ %><label><input type="checkbox" name="platforms" value="<%= p %>" <%= (form.platforms||[]).includes(p)?"checked":"" %>><span><%= p %></span></label><% }) %></div></fieldset></section>
<section class="form-card"><div class="form-title"><span>03</span><div><h2>ภาพประชาสัมพันธ์</h2><p>JPG, PNG หรือ WebP ภาพละไม่เกิน <%= maxUploadMb %> MB</p></div></div><% if(game?.cover_path){ %><div class="current-cover"><img src="<%= game.cover_path %>" alt=""><span>ภาพปัจจุบัน</span></div><% } %><div class="fields"><label>ภาพปกเกม<input type="file" name="cover" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"><small>แนะนำ 16:9</small></label><label>Screenshot<input type="file" name="screenshots" multiple accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"><small>รวมของเดิมและใหม่ไม่เกิน 20 ภาพ</small></label></div></section>
<section class="form-card"><div class="form-title"><span>04</span><div><h2>วิดีโอ YouTube</h2><p>สูงสุด 3 วิดีโอ</p></div></div><div class="three"><% [0,1,2].forEach(i=>{ %><label>YouTube URL <%= i+1 %><input type="url" name="video_url" value="<%= (form.video_url||[])[i]||'' %>" placeholder="https://youtu.be/..."></label><% }) %></div></section>
<section class="form-card"><div class="form-title"><span>05</span><div><h2>ลิงก์ซื้อ ดาวน์โหลด หรือทดลองเล่น</h2><p>ระบบพาผู้ชมไปยังเว็บไซต์ภายนอกของคุณ</p></div></div><div class="link-list"><% [0,1,2,3,4,5].forEach(i=>{ %><div><label>ชื่อปุ่ม<input name="link_label" value="<%= (form.link_label||[])[i]||'' %>" placeholder="เช่น ซื้อบน Steam"></label><label>URL<input type="url" name="link_url" value="<%= (form.link_url||[])[i]||'' %>" placeholder="https://..."></label></div><% }) %></div></section>
<div class="policy"><strong>ก่อนเผยแพร่</strong><p>คุณยืนยันว่ามีสิทธิ์ใช้ข้อมูลและภาพทั้งหมด ไม่ละเมิดลิขสิทธิ์ และยอมรับว่าผู้ดูแลมีสิทธิ์ซ่อนหรือลบเนื้อหาที่ไม่เหมาะสมตาม <a href="/terms" target="_blank">นโยบายเนื้อหา</a></p></div><div class="form-actions"><a class="btn btn--ghost" href="<%= game?'/games/'+game.slug:'/dashboard' %>">ยกเลิก</a><button class="btn btn--gold"><%= mode==="create"?"เผยแพร่ผลงานเกม":"บันทึกการเปลี่ยนแปลง" %></button></div></form></div>
<aside class="help"><div class="panel"><span class="privacy">i</span><h2>เคล็ดลับ</h2><ol><li>ใช้ภาพปก 16:9</li><li>บอกจุดเด่นใน 2 บรรทัดแรก</li><li>ใส่ Screenshot จากเกมจริง</li><li>ตรวจลิงก์ก่อนบันทึก</li></ol><hr><strong>เราไม่รับฝากไฟล์เกม</strong><p>เก็บเฉพาะข้อมูล ภาพ และรหัสวิดีโอ YouTube</p></div></aside></div></section>
<% if(game?.screenshots?.length){ %><section class="section section--white"><div class="container"><h2>จัดการ Screenshot ปัจจุบัน</h2><div class="manage-shots"><% game.screenshots.forEach(s=>{ %><div><img src="<%= s.path %>" alt=""><form method="post" action="/games/<%= game.slug %>/screenshots/<%= s.id %>/delete" data-confirm="ลบภาพนี้?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ลบภาพ</button></form></div><% }) %></div></div></section><% } %><% if(game){ %><section class="danger"><div class="container"><div><h2>ลบผลงานนี้</h2><p>ข้อมูลและภาพทั้งหมดของเกมนี้จะถูกลบ</p></div><form method="post" action="/games/<%= game.slug %>/delete" data-confirm="ยืนยันลบผลงานถาวร?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--danger">ลบผลงาน</button></form></div></section><% } %></main><%- include("../partials/footer") %>
