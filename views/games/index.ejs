<%- include("../partials/head",{metaTitle,metaDescription}) %><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">ค้นพบผลงานใหม่</span><h1>เกมไทยทั้งหมด</h1><p>ค้นหาจากชื่อเกม นักพัฒนา หมวด และแพลตฟอร์ม</p><form class="filters" action="/games"><label>คำค้น<input name="q" value="<%= query %>" placeholder="ชื่อเกมหรือนักพัฒนา"></label><label>หมวด<select name="category"><option value="">ทุกหมวด</option><% Object.entries(categories).forEach(([k,c])=>{ %><option value="<%= k %>" <%= category===k?"selected":"" %>><%= c.label %></option><% }) %></select></label><label>แพลตฟอร์ม<select name="platform"><option value="">ทุกแพลตฟอร์ม</option><% platformOptions.forEach(p=>{ %><option <%= platform===p?"selected":"" %>><%= p %></option><% }) %></select></label><button class="btn btn--primary">ค้นหา</button></form></div></section><section class="section results"><div class="container"><div class="result-line"><strong>พบ <%= games.length %> เกม</strong><% if(query||category||platform){ %><a href="/games">ล้างตัวกรอง</a><% } %></div><% if(games.length){ %><div class="game-grid"><% games.forEach(game=>{ %><%- include("../partials/card",{game}) %><% }) %></div><% }else{ %><div class="empty"><h2>ยังไม่พบเกมที่ตรงกับการค้นหา</h2><p>ลองเปลี่ยนคำค้นหรือเลือกหมวดอื่น</p><a class="btn btn--primary" href="/games">ดูเกมทั้งหมด</a></div><% } %></div></section></main><%- include("../partials/footer") %>
