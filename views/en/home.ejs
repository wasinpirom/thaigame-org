<%- include("../partials/head",{metaTitle,metaDescription,metaImage:games[0]?.cover_path}) %><main id="main">
<section class="hero"><div class="pattern pattern--l"></div><div class="pattern pattern--r"></div><div class="container hero__grid"><div><span class="eyebrow">Thai games · Thai creators · Global discovery</span><h1>Discover Thai games<br><em>from creators worth watching</em></h1><p class="lead">A curated discovery space for games made by Thai developers or inspired by Thai culture. ThaiGame.org lists promotional pages only, while purchases and downloads stay on each creator's own platform.</p><form class="search" action="/en/games"><span>⌕</span><input name="q" type="search" placeholder="Search game titles, genres, or creators"><button class="btn btn--gold">Search</button></form><div class="stats"><div><strong><%= total %></strong><span>Games listed</span></div><div><strong><%= developers %></strong><span>Public creators</span></div><div><strong>0</strong><span>Hosted game files</span></div></div></div><div class="hero__covers"><span class="orbit"></span><% games.slice(0,3).forEach((g,i)=>{ %><a class="hero-cover hero-cover--<%= i+1 %>" href="/en/games/<%= g.slug %>"><% if(g.cover_path){ %><img src="<%= g.cover_path %>" alt="<%= g.title_en||g.title_th %>"><% }else{ %><span class="placeholder">TG</span><% } %><b><%= g.title_en||g.title_th %></b></a><% }) %></div></div></section>
<section class="section section--white"><div class="container"><div class="heading"><div><span class="eyebrow">Featured directory</span><h2>Latest Thai games</h2></div><a href="/en/games">Browse all →</a></div><div class="game-grid"><% games.forEach(game=>{ %><%- include("partials/card",{game}) %><% }) %></div></div></section>
<section class="section"><div class="container cta"><div><span class="eyebrow">Global discovery</span><h2>Find Thai-made games, creators, and community activity</h2></div><div><p>Explore the Thai game directory, follow local events, and connect directly to each creator's official links.</p><a class="btn btn--gold" href="/en/events">View Thai game events</a></div></div></section></main><%- include("../partials/footer") %>
