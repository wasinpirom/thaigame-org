<%- include("../../partials/head",{metaTitle,metaDescription}) %><main id="main"><section class="page-hero page-hero--compact"><div class="container"><span class="eyebrow"><%= event.event_type||"Community event" %></span><h1><%= event.title %></h1><p><%= formatDate(event.start_date) %><% if(event.end_date){ %> - <%= formatDate(event.end_date) %><% } %><% if(event.location){ %> · <%= event.location %><% } %></p></div></section><section class="section"><div class="container detail-grid"><article class="panel"><span class="eyebrow">Event details</span><div class="prose"><% event.description.split(/\n+/).forEach(p=>{ %><p><%= p %></p><% }) %></div><% if(event.registration_url){ %><a class="btn btn--gold" href="<%= event.registration_url %>" target="_blank" rel="noopener nofollow">Open main registration ↗</a><% } %></article><aside class="panel"><span class="eyebrow">Register</span><h2>Register on ThaiGame.org</h2><p><%= registered %> registrations here</p><%- include("../../partials/errors",{errors}) %><form class="stack" method="post" action="/events/<%= event.slug %>/register"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="attendee_name" value="<%= form.attendee_name||'' %>" required maxlength="120"></label><label>Email<input type="email" name="attendee_email" value="<%= form.attendee_email||'' %>" required></label><button class="btn btn--primary btn--block">Register</button></form></aside></div></section></main><%- include("../../partials/footer") %>
