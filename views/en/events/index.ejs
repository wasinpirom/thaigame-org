<%- include("../../partials/head",{metaTitle,metaDescription}) %><main id="main"><section class="page-hero page-hero--compact"><div class="container"><span class="eyebrow">Thai game calendar</span><h1>Events and Release Calendar</h1><p>Game jams, meetups, workshops, competitions, and Thai games scheduled for release this month.</p><p><a class="btn btn--gold" href="<%= currentUser?'/events/new':'/login?returnTo=/events/new' %>">Add event</a></p></div></section><section class="section"><div class="container events-layout"><div><div class="heading"><div><span class="eyebrow">Events</span><h2>Community Events</h2></div></div><% if(events.length){ %><div class="event-list"><% events.forEach(event=>{ %><article><time><%= formatDate(event.start_date) %></time><div><h3><a href="/en/events/<%= event.slug %>"><%= event.title %></a></h3><p><%= excerpt(event.description,170) %></p><div class="tags"><% if(event.event_type){ %><span><%= event.event_type %></span><% } %><% if(event.location){ %><span><%= event.location %></span><% } %></div></div><a class="btn btn--outline btn--sm" href="/en/events/<%= event.slug %>">Details</a></article><% }) %></div><% }else{ %><div class="empty"><h2>No events yet</h2><p>Members can add Thai game jams, meetups, or community events.</p></div><% } %></div><aside class="panel release-panel"><span class="eyebrow">Release calendar</span><h2>Games This Month</h2><% if(releases.length){ %><table><tbody><% releases.forEach(game=>{ %><tr><td><%= formatDate(game.release_date) %></td><td><a href="/en/games/<%= game.slug %>"><strong><%= game.title_en||game.title_th %></strong></a><small><%= game.platforms.join(" · ") %></small></td></tr><% }) %></tbody></table><% }else{ %><p>No games with release dates listed for this month yet.</p><a class="btn btn--outline btn--block" href="/en/games">View all games</a><% } %></aside></div></section></main><%- include("../../partials/footer") %>
