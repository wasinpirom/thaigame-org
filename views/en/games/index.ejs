<%- include("../../partials/head",{metaTitle,metaDescription}) %><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">Discover new work</span><h1>Thai Game Directory</h1><p>Search by game title, creator, category, or platform.</p><form class="filters" action="/en/games"><label>Search<input name="q" value="<%= query %>" placeholder="Game title or creator"></label><label>Category<select name="category"><option value="">All categories</option><% Object.entries(categories).forEach(([k,c])=>{ %><option value="<%= k %>" <%= category===k?"selected":"" %>><%= c.label %></option><% }) %></select></label><label>Platform<select name="platform"><option value="">All platforms</option><% platformOptions.forEach(p=>{ %><option <%= platform===p?"selected":"" %>><%= p %></option><% }) %></select></label><button class="btn btn--primary">Search</button></form></div></section><section class="section results"><div class="container"><div class="result-line"><strong><%= games.length %> games found</strong><% if(query||category||platform){ %><a href="/en/games">Clear filters</a><% } %></div><% if(games.length){ %><div class="game-grid"><% games.forEach(game=>{ %><%- include("../partials/card",{game}) %><% }) %></div><% }else{ %><div class="empty"><h2>No matching games yet</h2><p>Try another keyword or category.</p><a class="btn btn--primary" href="/en/games">View all games</a></div><% } %></div></section></main><%- include("../../partials/footer") %>
