<% const title=game.title_en||game.title_th, summary=game.short_description_en||game.short_description, details=game.description_en||game.description; %><%- include("../../partials/head",{metaTitle,metaDescription,metaImage:game.cover_path}) %><main id="main"><% if(game.status==="hidden"){ %><div class="moderation"><div class="container"><strong>This game is hidden from public listings.</strong> <%= game.admin_note %></div></div><% } %><section class="game-hero"><div class="container game-hero__grid"><div class="big-cover"><% if(game.cover_path){ %><img src="<%= game.cover_path %>" alt="Cover image for <%= title %>"><% }else{ %><span class="placeholder">TG</span><% } %></div><div><div class="tags"><% game.categories.forEach(k=>{if(categories[k]){ %><a href="/en/games?category=<%= k %>"><%= categories[k].label %></a><% }}); %><% if(game.ai_usage){ %><span class="tag--ai">AI disclosure</span><% } %></div><h1><%= title %></h1><% if(game.title_en&&game.title_th!==game.title_en){ %><p class="title-en"><%= game.title_th %></p><% } %><p class="lead"><%= summary %></p><dl class="facts"><div><dt>Creator</dt><dd><%= game.developer_name||(game.profile_public?game.owner_name:"Private team") %></dd></div><div><dt>Platforms</dt><dd><%= game.platforms.join(" · ") %></dd></div><% if(game.release_date){ %><div><dt>Release</dt><dd><%= formatDate(game.release_date) %></dd></div><% } %><div><dt>Views</dt><dd><%= game.views %></dd></div></dl><div class="actions"><% game.links.forEach((l,i)=>{ %><a class="btn <%= i?"btn--outline":"btn--gold" %>" href="<%= l.url %>" target="_blank" rel="noopener nofollow"><%= l.label %> ↗</a><% }) %></div><small>Links open external websites. Check details before buying or downloading.</small><% if(canManage){ %><p><a class="edit-link" href="/games/<%= game.slug %>/edit">✎ Edit this game</a></p><% } %></div></div></section><section class="section"><div class="container detail-grid"><article class="panel"><span class="eyebrow">About this game</span><h2>Game Details</h2><div class="prose"><% details.split(/\n+/).forEach(p=>{ %><p><%= p %></p><% }) %></div><% if(game.ai_usage){ %><div class="ai-disclosure"><strong>AI use disclosed by the creator</strong><p><%= game.ai_usage %></p></div><% } %></article><aside class="panel identity"><% if(owner){ %><div class="identity__head"><% if(owner.avatar_path){ %><img src="<%= owner.avatar_path %>" alt=""><% }else{ %><span><%= owner.display_name[0] %></span><% } %><div><small>Creator profile</small><h2><%= owner.display_name %></h2></div></div><p><%= excerpt(owner.bio,180) %></p><a class="btn btn--outline btn--block" href="/en/developers/<%= owner.id %>">View all games</a><% }else{ %><div class="privacy">●</div><h2>Creator profile is private</h2><p>You can still view the game and use the official links provided by the creator.</p><% } %></aside></div></section><% if(game.screenshots.length){ %><section class="section section--white"><div class="container"><div class="heading"><h2>Screenshots</h2><span><%= game.screenshots.length %> images</span></div><div class="shots"><% game.screenshots.forEach((s,i)=>{ %><button data-lightbox="<%= s.path %>"><img src="<%= s.path %>" alt="Screenshot <%= i+1 %>"></button><% }) %></div></div></section><% } %><% if(game.videos.length){ %><section class="section"><div class="container"><h2>YouTube Videos</h2><div class="videos"><% game.videos.forEach(v=>{ %><iframe src="https://www.youtube.com/embed/<%= v.youtube_id %>" title="Video for <%= title %>" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen loading="lazy"></iframe><% }) %></div></div></section><% } %></main><div class="lightbox" hidden><button data-lightbox-close>×</button><img alt="Large screenshot"></div><%- include("../../partials/footer") %>
