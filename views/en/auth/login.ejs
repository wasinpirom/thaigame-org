<%- include("../../partials/head",{metaTitle,noindex:true}) %><main id="main" class="auth"><div class="auth__art auth__art--login"><span>◈</span><h2>Welcome back<br>to the community</h2><p>Edit, update, and help your games get discovered.</p></div><section><div class="auth__box"><span class="eyebrow">Members</span><h1>Sign in</h1><p>Manage your games and creator profile.</p><%- include("../../partials/errors",{errors}) %><form class="stack" method="post" action="/en/login"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="<%= returnTo %>"><label>Email<input type="email" name="email" value="<%= form.email %>" required></label><label>Password<input type="password" name="password" required></label><button class="btn btn--gold btn--block">Sign in</button></form><p class="note">If you forgot your password, contact the administrator with the email used for registration.</p><p class="switch">No account yet? <a href="/en/register">Create one for free</a></p></div></section></main><%- include("../../partials/footer") %>
