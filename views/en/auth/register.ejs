<%- include("../../partials/head",{metaTitle,noindex:true}) %><main id="main" class="auth"><div class="auth__art"><span>✦</span><h2>Bring Thai games<br>to a wider world</h2><p>Create a public game page and connect players to your official channels.</p></div><section><div class="auth__box"><span class="eyebrow">Free account</span><h1>Create your ThaiGame.org account</h1><p>You can choose later whether your creator profile is public.</p><%- include("../../partials/errors",{errors}) %><form class="stack" method="post" action="/en/register"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Display name<input name="display_name" value="<%= form.display_name %>" required maxlength="100" placeholder="Person, team, or studio name"></label><label>Email<input type="email" name="email" value="<%= form.email %>" required></label><label>Password<input type="password" name="password" required minlength="10" maxlength="128"><small>At least 10 characters</small></label><label class="terms"><input type="checkbox" name="accept_terms" value="1" required><span>I accept the <a href="/en/terms" target="_blank">terms and content policy</a></span></label><button class="btn btn--gold btn--block">Create account</button></form><p class="switch">Already have an account? <a href="/en/login">Sign in</a></p></div></section></main><%- include("../../partials/footer") %>
