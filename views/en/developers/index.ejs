<%- include("../../partials/head",{metaTitle,metaDescription}) %><main id="main"><section class="page-hero"><div class="container"><span class="eyebrow">People behind Thai games</span><h1>Creators and Studios</h1><p>Public creator profiles with games and contact links.</p></div></section><section class="section"><div class="container"><% if(developers.length){ %><div class="dev-grid"><% developers.forEach(d=>{ %><article><a class="dev-avatar" href="/en/developers/<%= d.id %>"><% if(d.avatar_path){ %><img src="<%= d.avatar_path %>" alt=""><% }else{ %><span><%= d.display_name[0] %></span><% } %></a><div><span class="tag">Public profile</span><h2><a href="/en/developers/<%= d.id %>"><%= d.display_name %></a></h2><p><%= excerpt(d.bio,140)||"A member of the Thai game creator community" %></p><strong><%= d.game_count %> games · <a href="/en/developers/<%= d.id %>">View profile →</a></strong></div></article><% }) %></div><% }else{ %><div class="empty"><h2>No public creator profiles yet</h2></div><% } %></div></section></main><%- include("../../partials/footer") %>
