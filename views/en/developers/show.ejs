<%- include("../../partials/head",{metaTitle,metaDescription,metaImage:developer.avatar_path}) %><main id="main"><section class="dev-hero"><div class="container dev-profile"><div class="dev-profile__avatar"><% if(developer.avatar_path){ %><img src="<%= developer.avatar_path %>" alt=""><% }else{ %><span><%= developer.display_name[0] %></span><% } %></div><div><span class="eyebrow">Creator profile</span><h1><%= developer.display_name %></h1><p><%= developer.bio||"ThaiGame.org member" %></p><div class="socials"><% [["Website",developer.website_url],["Facebook",developer.facebook_url],["X",developer.x_url],["YouTube",developer.youtube_url],["itch.io",developer.itch_url],["Steam",developer.steam_url]].forEach(x=>{if(x[1]){ %><a href="<%= x[1] %>" target="_blank" rel="noopener"><%= x[0] %> ↗</a><% }}); %></div></div><aside class="panel contacts"><span class="eyebrow">Contact</span><% if(developer.contact_email){ %><a href="mailto:<%= developer.contact_email %>">Email<strong><%= developer.contact_email %></strong></a><% } %><% if(developer.line_id){ %><div>LINE ID<strong><%= developer.line_id %></strong></div><% } %><% if(developer.phone){ %><a href="tel:<%= developer.phone %>">Phone<strong><%= developer.phone %></strong></a><% } %></aside></div></section><section class="section"><div class="container"><div class="heading"><h2><%= games.length %> games on ThaiGame.org</h2></div><div class="game-grid"><% games.forEach(game=>{ %><%- include("../partials/card",{game}) %><% }) %></div></div></section></main><%- include("../../partials/footer") %>
