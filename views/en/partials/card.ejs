<article class="game-card"><a class="game-card__cover" href="/en/games/<%= game.slug %>"><% if(game.cover_path){ %><img src="<%= game.cover_path %>" alt="Cover image for <%= game.title_en||game.title_th %>" loading="lazy"><% }else{ %><span class="placeholder">TG</span><% } %><% if(game.featured){ %><span class="featured">Featured</span><% } %></a><div class="game-card__body"><div class="tags"><% game.categories.slice(0,2).forEach(k=>{if(categories[k]){ %><span><%= categories[k].short %></span><% }}); %><% if(game.ai_usage){ %><span class="tag--ai">AI disclosure</span><% } %></div><h3><a href="/en/games/<%= game.slug %>"><%= game.title_en||game.title_th %></a></h3><% if(game.title_en&&game.title_th!==game.title_en){ %><small><%= game.title_th %></small><% } %><p><%= excerpt(game.short_description_en||game.short_description,115) %></p><div class="game-card__meta"><span><%= game.developer_name||(game.profile_public?game.owner_name:"Private profile") %></span><span>◉ <%= Number(game.views||0).toLocaleString("en-US") %></span></div></div></article>
