<%- include("partials/head",{metaTitle,noindex:true}) %><main id="main"><section class="dash-hero"><div class="container"><div><span class="eyebrow">แดชบอร์ดของฉัน</span><h1>สวัสดี <%= currentUser.display_name %></h1><p>จัดการผลงานและข้อมูลการติดต่อ</p></div><a class="btn btn--gold" href="/games/new">＋ เพิ่มผลงานเกม</a></div></section><section class="section"><div class="container dash-grid"><aside class="profile-card"><% if(currentUser.avatar_path){ %><img src="<%= currentUser.avatar_path %>" alt=""><% }else{ %><span class="profile-card__avatar"><%= currentUser.display_name[0] %></span><% } %><h2><%= currentUser.display_name %></h2><p><%= currentUser.email %></p><b class="<%= currentUser.profile_public?'public':'private' %>"><%= currentUser.profile_public?'โปรไฟล์สาธารณะ':'ไม่เปิดเผยโปรไฟล์' %></b><% if(currentUser.profile_public){ %><a class="btn btn--outline btn--block" href="/developers/<%= currentUser.id %>">ดูโปรไฟล์</a><% } %><a class="btn btn--ghost btn--block" href="/profile/edit">แก้ไขโปรไฟล์และรหัสผ่าน</a></aside><div><div class="heading"><h2>ผลงานของฉัน (<%= games.length %>)</h2></div><% if(games.length){ %><div class="my-games"><% games.forEach(g=>{ %><article><a href="/games/<%= g.slug %>"><% if(g.cover_path){ %><img src="<%= g.cover_path %>" alt=""><% }else{ %><span class="placeholder">TG</span><% } %></a><div><span class="status status--<%= g.status %>"><%= g.status==="published"?"เผยแพร่แล้ว":"ถูกซ่อน" %></span><h3><a href="/games/<%= g.slug %>"><%= g.title_th %></a></h3><p><%= excerpt(g.short_description,120) %></p><small>◉ <%= g.views %> ครั้ง · อัปเดต <%= formatDate(g.updated_at) %></small></div><div><a class="btn btn--outline btn--sm" href="/games/<%= g.slug %>">ดู</a><a class="btn btn--primary btn--sm" href="/games/<%= g.slug %>/edit">แก้ไข</a></div></article><% }) %></div><% }else{ %><div class="empty"><h2>ยังไม่มีผลงานเกม</h2><a class="btn btn--gold" href="/games/new">เพิ่มผลงานแรก</a></div><% } %></div></div></section></main><%- include("partials/footer") %>
