<%- include("partials/head",{metaTitle,metaDescription,metaImage:heroNews[0]&&heroNews[0].image_url.startsWith('/')?heroNews[0].image_url:''}) %><main id="main">
<section class="hero"><div class="pattern pattern--l"></div><div class="pattern pattern--r"></div><div class="container hero__grid"><div><span class="eyebrow">AI-curated · Thai game news · โดย ดร.วศิน ภิรมย์</span><h1>ข่าวเกมไทย<br><em>อัปเดตด้วย AI ทุกวัน</em></h1><p class="lead">AI ตามเก็บเกมใหม่ของคนไทย ข่าวเครื่องมือพัฒนาเกม และปฏิทิน Game Jam มาเล่าเป็นภาษาไทย ฟรี</p><form class="search" action="/news"><span>⌕</span><input name="q" type="search" placeholder="ค้นหาข่าวเกม เครื่องมือ หรือชื่อเกม"><button class="btn btn--gold">ค้นหา</button></form><div class="stats"><div><strong><%= stats.news %></strong><span>ข่าวเกม</span></div><div><strong><%= jamBlock.running+jamBlock.upcoming %></strong><span>Game Jam</span></div><div><strong><%= stats.videos %></strong><span>วิดีโอ</span></div></div></div><div class="hero__covers"><span class="orbit"></span><% heroNews.forEach((a,i)=>{ %><a class="hero-cover hero-cover--<%= i+1 %>" href="/news/<%= a.slug %>"><% if(a.image_url){ %><img src="<%= a.image_url %>" alt="" referrerpolicy="no-referrer"><b><%= a.title %></b><% }else{ %><%- include("partials/text-cover",{title:a.title,kind:a.kind,size:"tall"}) %><% } %></a><% }) %></div></div></section>
<section class="jam-band"><div class="container"><div class="jam-band__head"><div><span class="eyebrow">🔥 Game Jam Calendar</span><h2>ปฏิทิน Game Jam <em>นับถอยหลัง</em></h2><p>กำลังจัดอยู่ <b><%= jamBlock.running %></b> งาน · เร็ว ๆ นี้ <b><%= jamBlock.upcoming %></b> งาน อัปเดตจาก itch.io อัตโนมัติ</p></div><a class="btn btn--gold" href="/jams">ดูปฏิทินทั้งหมด →</a></div><% if(jamBlock.spotlight.length){ %><div class="jam-grid jam-grid--band"><% jamBlock.spotlight.forEach(j=>{ %><%- include("partials/jam-card",{j}) %><% }) %></div><% }else{ %><p class="jam-band__empty">กำลังโหลดปฏิทิน Game Jam จาก itch.io…</p><% } %></div></section>
<section class="section section--white"><div class="container"><div class="heading"><div><span class="eyebrow">ล่าสุด · AI-assisted · ตรวจโดยบรรณาธิการ</span><h2>ข่าวเกมไทย</h2></div><a href="/news?kind=thai_game">ดูทั้งหมด →</a></div><% if(thaiNews.length){ %><div class="news-grid"><% thaiNews.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div><% }else{ %><div class="empty empty--sm"><p>AI กำลังรวบรวมข่าวเกมไทยจาก itch.io, YouTube และสื่อต่าง ๆ</p></div><% } %></div></section>
<% if(devNews.length){ %><section class="section"><div class="container"><div class="heading"><div><span class="eyebrow">Tools · Engines · Innovation</span><h2>รู้ทันวงการพัฒนาเกม</h2></div><a href="/news?kind=devnews">ดูทั้งหมด →</a></div><div class="news-grid"><% devNews.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div></div></section><% } %>
<% if(videos.length||courses.length){ %><section class="section section--white"><div class="container <%= videos.length&&courses.length?'two-col':'' %>"><% if(videos.length){ %><div><div class="heading"><div><span class="eyebrow">YouTube</span><h2>วิดีโอเกมไทย</h2></div><a href="/videos">ดูทั้งหมด →</a></div><div class="news-grid <%= courses.length?'news-grid--2':'' %>"><% videos.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div></div><% } %><% if(courses.length){ %><div><div class="heading"><div><span class="eyebrow">Learn</span><h2>คอร์สสร้างเกมน่าสนใจ</h2></div><a href="/learn">ดูทั้งหมด →</a></div><div class="news-grid <%= videos.length?'news-grid--2':'' %>"><% courses.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div></div><% } %></div></section><% } %>
<section class="section"><div class="container cta"><div><span class="eyebrow">ให้ AI ค้นพบผลงานของคุณ</span><h2>ทำเกมอยู่?<br>แค่เผยแพร่ในที่ที่คนเห็น</h2></div><div><p>ลงเกมบน itch.io แล้วติดแท็ก <strong>thailand</strong> หรือเผยแพร่คลิปบน YouTube ระบบ AI ของ ThaiGame.org ตามเก็บและอาจหยิบมาเล่าเป็นข่าวให้อัตโนมัติ มีข่าวหรือผลงานอยากแนะนำ แจ้งได้ที่ LINE OA</p><a class="btn btn--gold" href="<%= lineOaUrl %>" target="_blank" rel="noopener">แนะนำผลงานทาง LINE <%= lineOaId %></a></div></div></section></main><%- include("partials/footer") %>
