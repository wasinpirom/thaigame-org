<%- include("partials/head",{metaTitle,metaDescription,metaImage:games[0]?.cover_path}) %><main id="main">
<section class="hero"><div class="pattern pattern--l"></div><div class="pattern pattern--r"></div><div class="container hero__grid"><div><span class="eyebrow">Thai game news · Thai creators · โดย ดร.วศิน ภิรมย์</span><h1>พื้นที่ของเกมไทย<br><em>ให้คนทั้งโลกได้ค้นพบ</em></h1><p class="lead">ข่าวเกมใหม่จากนักพัฒนาไทย เครื่องมือและนวัตกรรมการพัฒนาเกม วิดีโอ และคอร์สสร้างเกม รวมไว้ที่เดียว ใช้งานฟรี และไม่รับฝากไฟล์เกม</p><form class="search" action="/games"><span>⌕</span><input name="q" type="search" placeholder="ค้นหาชื่อเกม แนวเกม หรือนักพัฒนา"><button class="btn btn--gold">ค้นหา</button></form><div class="stats"><div><strong><%= total %></strong><span>ผลงานเกม</span></div><div><strong><%= developers %></strong><span>โปรไฟล์สาธารณะ</span></div><div><strong>0</strong><span>ไฟล์เกมที่ฝากไว้</span></div></div></div><div class="hero__covers"><span class="orbit"></span><% games.slice(0,3).forEach((g,i)=>{ %><a class="hero-cover hero-cover--<%= i+1 %>" href="/games/<%= g.slug %>"><img src="<%= g.cover_path %>" alt="<%= g.title_th %>"><b><%= g.title_th %></b></a><% }) %></div></div></section>
<section class="jam-band"><div class="container"><div class="jam-band__head"><div><span class="eyebrow">🔥 Game Jam Calendar</span><h2>ปฏิทิน Game Jam <em>นับถอยหลัง</em></h2><p>กำลังจัดอยู่ <b><%= jamBlock.running %></b> งาน · เร็ว ๆ นี้ <b><%= jamBlock.upcoming %></b> งาน อัปเดตจาก itch.io อัตโนมัติ</p></div><a class="btn btn--gold" href="/jams">ดูปฏิทินทั้งหมด →</a></div><% if(jamBlock.spotlight.length){ %><div class="jam-grid jam-grid--band"><% jamBlock.spotlight.forEach(j=>{ %><%- include("partials/jam-card",{j}) %><% }) %></div><% }else{ %><p class="jam-band__empty">กำลังโหลดปฏิทิน Game Jam จาก itch.io…</p><% } %></div></section>
<section class="section section--white"><div class="container"><div class="heading"><div><span class="eyebrow">ล่าสุด · AI-assisted · ตรวจโดยบรรณาธิการ</span><h2>ข่าวเกมไทย</h2></div><a href="/news?kind=thai_game">ดูทั้งหมด →</a></div><% if(thaiNews.length){ %><div class="news-grid"><% thaiNews.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div><% }else{ %><div class="empty empty--sm"><p>กำลังรวบรวมข่าวเกมไทยจาก itch.io, YouTube และสื่อต่าง ๆ</p></div><% } %></div></section>
<% if(devNews.length){ %><section class="section"><div class="container"><div class="heading"><div><span class="eyebrow">Tools · Engines · Innovation</span><h2>รู้ทันวงการพัฒนาเกม</h2></div><a href="/news?kind=devnews">ดูทั้งหมด →</a></div><div class="news-grid"><% devNews.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div></div></section><% } %>
<% if(videos.length||courses.length){ %><section class="section section--white"><div class="container <%= videos.length&&courses.length?'two-col':'' %>"><% if(videos.length){ %><div><div class="heading"><div><span class="eyebrow">YouTube</span><h2>วิดีโอเกมไทย</h2></div><a href="/videos">ดูทั้งหมด →</a></div><div class="news-grid <%= courses.length?'news-grid--2':'' %>"><% videos.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div></div><% } %><% if(courses.length){ %><div><div class="heading"><div><span class="eyebrow">Learn</span><h2>คอร์สสร้างเกมน่าสนใจ</h2></div><a href="/learn">ดูทั้งหมด →</a></div><div class="news-grid <%= videos.length?'news-grid--2':'' %>"><% courses.forEach(a=>{ %><%- include("partials/news-card",{a}) %><% }) %></div></div><% } %></div></section><% } %>
<section class="section section--white"><div class="container"><div class="heading"><div><span class="eyebrow">เพิ่งเพิ่มในระบบ</span><h2>เกมน่าสนใจจากชุมชน</h2></div><a href="/games">ดูทั้งหมด →</a></div><div class="game-grid"><% games.forEach(game=>{ %><%- include("partials/card",{game}) %><% }) %></div></div></section>
<section class="section"><div class="container"><div class="heading heading--center"><div><span class="eyebrow">เกมไทยในความหมายที่กว้างกว่า</span><h2>เลือกค้นพบในแบบที่สนใจ</h2></div></div><div class="cat-grid"><% Object.entries(categories).forEach(([k,c],i)=>{ %><a class="cat cat--<%= i+1 %>" href="/games?category=<%= k %>"><span><%= ["✦","◈","❖"][i] %></span><h3><%= c.label %></h3><p><%= c.desc %></p><strong><%= counts[k] %> เกม →</strong></a><% }) %></div></div></section>
<section class="section section--white"><div class="container"><div class="heading"><div><span class="eyebrow">Game jams · Events · Releases</span><h2>ติดตามกิจกรรมและเกมที่กำลังปล่อย</h2></div><a href="/events">ดูปฏิทินเกมไทย →</a></div><div class="cat-grid"><a class="cat" href="/events"><span>◎</span><h3>กิจกรรมเกมในไทย</h3><p>รวม Game Jam งานพบปะ เวิร์กช็อป และงานประกวดจากชุมชน</p><strong>ดู Events →</strong></a><a class="cat" href="/events"><span>▣</span><h3>ตารางเกมที่ปล่อย</h3><p>ดูรายชื่อเกมที่ระบุวันวางจำหน่ายในสัปดาห์หรือเดือนนี้</p><strong>ดู Release Calendar →</strong></a><a class="cat" href="<%= currentUser?'/events/new':'/login?returnTo=/events/new' %>"><span>＋</span><h3>เพิ่มกิจกรรมของคุณ</h3><p>สมาชิกสามารถเสนอ event และเปิดรับลงทะเบียนเบื้องต้นได้</p><strong>สร้าง Event →</strong></a></div></div></section>
<section class="section section--white"><div class="container cta"><div><span class="eyebrow">ผลงานของคุณควรถูกค้นพบ</span><h2>มีเกมที่พัฒนาโดยคนไทย<br>หรือถ่ายทอดความเป็นไทยไหม?</h2></div><div><p>สร้างหน้าแสดงผลงาน ใส่ภาพ วิดีโอ และลิงก์ไปยังหน้าซื้อหรือดาวน์โหลดของคุณ</p><a class="btn btn--gold" href="<%= currentUser?'/games/new':'/register' %>">เริ่มเพิ่มผลงานเกม</a></div></div></section></main><%- include("partials/footer") %>
