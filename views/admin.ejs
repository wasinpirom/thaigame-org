<%- include("partials/head",{metaTitle,noindex:true}) %><main id="main"><section class="dash-hero dash-hero--admin"><div class="container"><div><span class="eyebrow">Admin control</span><h1>ผู้ดูแล ThaiGame.org</h1><p>ตรวจสอบผลงาน สมาชิก และสถานะการเผยแพร่</p></div><a class="btn btn--gold" href="/games/new">เพิ่มเกม</a></div></section><section class="section"><div class="container"><div class="stat-grid"><div><span>เกมทั้งหมด</span><strong><%= stats.games %></strong></div><div><span>เผยแพร่</span><strong><%= stats.published %></strong></div><div><span>สมาชิก</span><strong><%= stats.users %></strong></div><div><span>Screenshot</span><strong><%= stats.images %></strong></div></div><section id="games" class="admin-section"><h2>จัดการเกม</h2><div class="table-wrap"><table><thead><tr><th>เกม</th><th>เจ้าของ</th><th>สถานะ</th><th>จัดการ</th></tr></thead><tbody><% games.forEach(g=>{ %><tr><td><a href="/games/<%= g.slug %>"><strong><%= g.title_th %></strong></a><small><%= g.platforms.join(" · ") %></small></td><td><%= g.owner_name %><small><%= g.owner_email %></small></td><td><span class="status status--<%= g.status %>"><%= g.status==="published"?"เผยแพร่":"ซ่อน" %></span></td><td><div class="admin-actions"><a href="/games/<%= g.slug %>/edit">แก้ไข</a><form method="post" action="/admin/games/<%= g.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= g.status==='published'?'hidden':'published' %>"><input name="admin_note" value="<%= g.admin_note %>" placeholder="หมายเหตุ"><button><%= g.status==="published"?"ซ่อน":"เผยแพร่" %></button></form><form method="post" action="/games/<%= g.slug %>/delete" data-confirm="ลบเกมนี้ถาวร?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="red">ลบ</button></form></div></td></tr><% }) %></tbody></table></div></section><section id="users" class="admin-section"><h2>จัดการสมาชิก</h2><div class="table-wrap"><table><thead><tr><th>สมาชิก</th><th>บทบาท</th><th>เกม</th><th>โปรไฟล์</th><th>สถานะ</th><th>จัดการ</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.display_name %></strong><small><%= u.email %></small></td><td><%= u.role %></td><td><%= u.game_count %></td><td><%= u.profile_public?"สาธารณะ":"ส่วนตัว" %></td><td><span class="status status--<%= u.status %>"><%= u.status==="active"?"ใช้งาน":"ระงับ" %></span></td><td><% if(u.id!==currentUser.id){ %><form method="post" action="/admin/users/<%= u.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= u.status==='active'?'suspended':'active' %>"><button><%= u.status==="active"?"ระงับ":"เปิดใช้" %></button></form><% } %></td></tr><% }) %></tbody></table></div></section></div></section></main><%- include("partials/footer") %>
