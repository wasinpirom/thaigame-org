<%- include("../partials/head",{metaTitle,noindex:true}) %><main id="main"><section class="dash-hero dash-hero--admin"><div class="container"><div><span class="eyebrow">Game Jam calendar</span><h1>จัดการ Game Jam</h1><p>ดึงจาก itch.io อัตโนมัติทุก 12 ชม. · สถานะล่าสุด: <%= status %><%= lastFetch?' ('+ago(lastFetch)+')':'' %></p></div><form method="post" action="/admin/jams/fetch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--gold">ดึงจาก itch.io ตอนนี้</button></form></div></section><%- include("../partials/admin-nav") %><section class="section section--tight"><div class="container"><div class="form-card"><h2>เพิ่ม Jam เอง (เช่น งานในไทย, Global Game Jam Thailand)</h2><%- include("../partials/errors",{errors}) %><form method="post" action="/admin/jams" class="fields"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="full">ลิงก์ของงาน *<input name="url" type="url" required value="<%= form.url||'' %>"></label><label>เริ่ม (เวลาไทย) *<input name="start" type="datetime-local" required value="<%= form.start||'' %>"></label><label>สิ้นสุด / ปิดส่งงาน<input name="end" type="datetime-local" value="<%= form.end||'' %>"></label><label>ชื่องาน (ว่างไว้ = ดึงจากลิงก์)<input name="title" value="<%= form.title||'' %>"></label><label>ผู้จัด<input name="host" value="<%= form.host||'' %>"></label><label class="full">ลิงก์รูป (ไม่บังคับ)<input name="image_url" value="<%= form.image_url||'' %>"></label><label class="check full"><input type="checkbox" name="is_thai" value="1" checked> งานในไทย / เกี่ยวกับไทย (ขึ้นก่อนบนหน้าแรก)</label><button class="btn btn--gold">เพิ่ม Jam</button></form></div><div class="table-wrap"><table><thead><tr><th>Jam</th><th>วันเวลา (ไทย)</th><th>คน</th><th>สถานะ</th><th>จัดการ</th></tr></thead><tbody><% jams.forEach(j=>{ const st=jamHelpers.jamState(j); %><tr class="<%= j.hidden?'is-off':'' %>"><td><a href="<%= j.url %>" target="_blank" rel="noopener"><strong><%= j.title %></strong></a><small><%= j.source %><%= j.host?' · '+j.host:'' %></small></td><td><small><%= jamHelpers.bkk(j.start_at) %></small><small><%= j.end_at?'→ '+jamHelpers.bkk(j.end_at):'' %></small></td><td><%= j.joined||'' %></td><td><small><%= st.label %></small><small><%= j.is_thai?'🇹🇭 ไทย':'' %> <%= j.featured?'📌 ปักหมุด':'' %> <%= j.hidden?'🙈 ซ่อน':'' %></small></td><td><div class="admin-actions"><% [["featured",j.featured?"เลิกปักหมุด":"ปักหมุด"],["is_thai",j.is_thai?"ไม่ใช่ไทย":"ติดป้ายไทย"],["hidden",j.hidden?"แสดง":"ซ่อน"]].forEach(([f,l])=>{ %><form method="post" action="/admin/jams/<%= j.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="field" value="<%= f %>"><button><%= l %></button></form><% }) %><form method="post" action="/admin/jams/<%= j.id %>/delete" data-confirm="ลบ jam นี้?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="red">ลบ</button></form></div></td></tr><% }) %></tbody></table></div></div></section></main><%- include("../partials/footer") %>
