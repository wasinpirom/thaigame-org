<%- include("../partials/head",{metaTitle,noindex:true}) %><main id="main"><section class="dash-hero dash-hero--admin"><div class="container"><div><span class="eyebrow">Newsroom</span><h1>อนุมัติข่าว</h1><p>ข่าวที่ AI เขียนเสร็จจะมารออยู่ที่นี่ ตรวจ แก้ไข แล้วกดเผยแพร่</p></div><a class="btn btn--gold" href="/admin/news/add">＋ เพิ่มลิงก์ / คอร์ส</a></div></section><%- include("../partials/admin-nav") %><section class="section section--tight"><div class="container"><%- include("_ai-status",{worker}) %><nav class="pills tabs"><a class="<%= status==='pending'?'on':'' %>" href="/admin/news?status=pending">รออนุมัติ (<%= pendingCount %>)</a><a class="<%= status==='published'?'on':'' %>" href="/admin/news?status=published">เผยแพร่แล้ว</a><a class="<%= status==='rejected'?'on':'' %>" href="/admin/news?status=rejected">ไม่อนุมัติ</a></nav><% if(articles.length){ %><form id="bulk" method="post" action="/admin/news/bulk" class="bulk-bar" data-confirm-delete="ลบรายการที่เลือกถาวร?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/admin/news?status=<%= status %>"><label class="check-all"><input type="checkbox" data-check-all="bulk"> เลือกทั้งหมด</label><button name="action" value="publish" class="btn btn--gold btn--sm">เผยแพร่ที่เลือก</button><button name="action" value="reject" class="btn btn--outline btn--sm">ไม่อนุมัติ</button><button name="action" value="delete" class="btn btn--danger btn--sm">ลบ</button></form><div class="review-list"><% articles.forEach(a=>{ %><article class="review"><input type="checkbox" name="ids" value="<%= a.id %>" form="bulk" aria-label="เลือก"><div class="review__img"><% if(a.image_url){ %><img src="<%= a.image_url %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } %></div><div class="review__body"><div class="tags"><span><%= newsKinds[a.kind]?newsKinds[a.kind].short:a.kind %></span><% if(a.ai_generated){ %><span class="tag--ai">AI · <%= a.ai_model %></span><% }else{ %><span>ไม่ใช้ AI</span><% } %><% if(a.featured){ %><span class="tag--hot">แนะนำ</span><% } %><small><%= ago(a.created_at) %> · <%= a.provider||a.source_name %></small></div><h3><a href="/news/<%= a.slug %>" target="_blank"><%= a.title %></a></h3><p><%= excerpt(a.excerpt,200) %></p><details><summary>อ่านเนื้อหาเต็ม</summary><div class="article__body"><%- renderBody(a.body) %></div><% if(a.source_url){ %><p><a href="<%= a.source_url %>" target="_blank" rel="noopener nofollow">ต้นทาง ↗</a></p><% } %></details><div class="admin-actions"><% if(a.status!=="published"){ %><form method="post" action="/admin/news/<%= a.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="published"><input type="hidden" name="back" value="/admin/news?status=<%= status %>"><button class="btn btn--gold btn--sm">✓ เผยแพร่</button></form><% } %><a class="btn btn--outline btn--sm" href="/admin/news/<%= a.id %>/edit">แก้ไข</a><% if(a.status==="pending"){ %><form method="post" action="/admin/news/<%= a.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="rejected"><input type="hidden" name="back" value="/admin/news?status=pending"><button class="btn btn--ghost btn--sm">ไม่อนุมัติ</button></form><% } %><% if(a.status==="published"){ %><form method="post" action="/admin/news/<%= a.id %>/feature"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/admin/news?status=published"><button class="btn btn--ghost btn--sm"><%= a.featured?'เลิกปักหมุด':'ปักหมุดแนะนำ' %></button></form><form method="post" action="/admin/news/<%= a.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="pending"><input type="hidden" name="back" value="/admin/news?status=published"><button class="btn btn--ghost btn--sm">ยกเลิกเผยแพร่</button></form><% } %><% if(a.item_id){ %><form method="post" action="/admin/news/<%= a.id %>/rewrite" data-confirm="ให้ AI เขียนข่าวนี้ใหม่? (ข้อความที่แก้ไว้จะหาย)"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost btn--sm">↻ ให้ AI เขียนใหม่</button></form><% } %><form method="post" action="/admin/news/<%= a.id %>/delete" data-confirm="ลบข่าวนี้ถาวร?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/admin/news?status=<%= status %>"><button class="red">ลบ</button></form></div></div></article><% }) %></div><% }else{ %><div class="empty"><h2>ไม่มีรายการ</h2><p><%= status==='pending'?'ยังไม่มีข่าวรออนุมัติ ดูรายการจากแหล่งข่าวแล้วเลือกให้ AI เขียนได้':'—' %></p><a class="btn btn--outline" href="/admin/feed">ไปที่รายการจากแหล่งข่าว</a></div><% } %></div></section></main><%- include("../partials/footer") %>
