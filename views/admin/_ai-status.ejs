<div class="ai-status <%= worker.lastError?'ai-status--err':'' %>"><div><strong>AI: <%= worker.model %></strong><small><%= worker.baseUrl %></small></div><div><span>วันนี้ใช้ <%= worker.usedToday %>/<%= worker.dailyLimit %></span><span><%= worker.busy?'⏳ กำลังเขียน…':(worker.enabled?'พร้อม':'ปิดอยู่ (AI_ENABLED=false)') %></span><% if(worker.lastRun){ %><span>งานล่าสุด <%= worker.lastDurationSec %> วินาที</span><% } %><span><%= worker.autoPublish?'เผยแพร่อัตโนมัติ':'รออนุมัติก่อนเผยแพร่' %></span></div><% if(worker.lastError){ %><p class="ai-status__error">ผิดพลาดล่าสุด: <%= worker.lastError %></p><% } %><form method="post" action="/admin/ai/test"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="<%= currentPath %>"><button class="btn btn--outline btn--sm">ทดสอบการเชื่อมต่อ AI</button></form></div>
