<%- include("../partials/head",{metaTitle,noindex:true}) %><main id="main"><section class="dash-hero dash-hero--admin"><div class="container"><div><span class="eyebrow">Edit article</span><h1>แก้ไขข่าว</h1><p>สถานะ: <%= {pending:"รออนุมัติ",published:"เผยแพร่แล้ว",rejected:"ไม่อนุมัติ"}[article.status] %></p></div><a class="btn btn--outline" href="/news/<%= article.slug %>" target="_blank">ดูตัวอย่าง</a></div></section><%- include("../partials/admin-nav") %><section class="section section--tight"><div class="container"><div class="form-card"><%- include("../partials/errors",{errors}) %><form method="post" action="/admin/news/<%= article.id %>/edit" class="fields"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="full">หัวข้อ<input name="title" required maxlength="200" value="<%= article.title %>"></label><label class="full">สรุปสั้น (แสดงในการ์ดและ Google)<textarea name="excerpt" rows="2" maxlength="300"><%= article.excerpt %></textarea></label><label class="full">เนื้อหา <small>ย่อหน้าคั่นด้วยบรรทัดว่าง · “## ” = หัวข้อย่อย · “- ” = รายการ · **ตัวหนา**</small><textarea name="body" rows="18"><%= article.body %></textarea></label><label>หมวด<select name="kind"><% Object.entries(newsKinds).forEach(([k,v])=>{ %><option value="<%= k %>" <%= article.kind===k?'selected':'' %>><%= v.label %></option><% }) %></select></label><label>ลิงก์รูปภาพ<input name="image_url" value="<%= article.image_url %>"></label><label>ลิงก์ต้นทาง<input name="source_url" value="<%= article.source_url %>"></label><label>ชื่อแหล่งที่มา<input name="source_name" value="<%= article.source_name %>"></label><label>ผู้ให้บริการคอร์ส (เช่น Udemy, Zenva)<input name="provider" value="<%= article.provider %>"></label><label>ลิงก์ YouTube (ถ้ามี)<input name="video_url" value="<%= article.video_id?'https://youtu.be/'+article.video_id:'' %>"></label><div class="form-actions full"><button class="btn btn--outline" name="publish" value="0">บันทึก</button><button class="btn btn--gold" name="publish" value="1">บันทึกและเผยแพร่</button></div></form></div></div></section></main><%- include("../partials/footer") %>
