<%- include("../partials/head",{metaTitle,noindex:true}) %><main id="main"><section class="dash-hero dash-hero--admin"><div class="container"><div><span class="eyebrow">Feed inbox</span><h1>รายการจากแหล่งข่าว</h1><p>ข้อมูลดิบจาก RSS / YouTube เลือกรายการที่น่าสนใจแล้วส่งให้ AI เขียนเป็นข่าว</p></div><form method="post" action="/admin/sources/fetch-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--gold">ดึงข่าวทุกแหล่งตอนนี้</button></form></div></section><%- include("../partials/admin-nav") %><section class="section section--tight"><div class="container"><%- include("_ai-status",{worker}) %><nav class="pills tabs"><a class="<%= status==='new'?'on':'' %>" href="/admin/feed?status=new">ใหม่ (ยังไม่เลือก)</a><a class="<%= status==='queued'?'on':'' %>" href="/admin/feed?status=queued">คิว AI</a><a class="<%= status==='error'?'on':'' %>" href="/admin/feed?status=error">ผิดพลาด</a><a class="<%= status==='done'?'on':'' %>" href="/admin/feed?status=done">เขียนแล้ว</a><a class="<%= status==='skipped'?'on':'' %>" href="/admin/feed?status=skipped">ข้ามแล้ว</a></nav><% if(status==='queued'&&items.length){ %><form method="post" action="/admin/ai/run" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--outline btn--sm">▶ เริ่มงาน AI ถัดไปทันที</button><small class="muted">ปกติระบบจะหยิบงานทีละ 1 รายการทุก 1 นาที</small></form><% } %><% if(items.length){ %><form id="bulk" method="post" action="/admin/feed/bulk" class="bulk-bar"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="/admin/feed?status=<%= status %>"><label class="check-all"><input type="checkbox" data-check-all="bulk"> เลือกทั้งหมด</label><button name="action" value="queue" class="btn btn--gold btn--sm">🤖 ให้ AI เขียน</button><button name="action" value="direct" class="btn btn--outline btn--sm">ลงแบบไม่ใช้ AI</button><button name="action" value="skip" class="btn btn--ghost btn--sm">ข้าม</button></form><div class="feed-list"><% items.forEach(i=>{ %><label class="feed-item"><input type="checkbox" name="ids" value="<%= i.id %>" form="bulk"><div class="feed-item__img"><% if(i.image_url){ %><img src="<%= i.image_url %>" alt="" loading="lazy" referrerpolicy="no-referrer"><% } %></div><div><div class="tags"><span><%= newsKinds[i.kind]?newsKinds[i.kind].short:i.kind %></span><small><%= i.source_name||'เพิ่มเอง' %> · <%= i.published_at?ago(i.published_at):'' %></small><% if(i.status==='processing'){ %><span class="tag--hot">กำลังเขียน…</span><% } %></div><strong><%= i.title %></strong><p><%= excerpt(i.summary,220) %></p><% if(i.error){ %><p class="error-text">⚠ <%= i.error %></p><% } %><% if(i.url){ %><a href="<%= i.url %>" target="_blank" rel="noopener nofollow" class="small-link">เปิดต้นทาง ↗</a><% } %></div></label><% }) %></div><% }else{ %><div class="empty"><h2>ไม่มีรายการ</h2><p>กด “ดึงข่าวทุกแหล่งตอนนี้” หรือเพิ่มแหล่งข่าวใหม่</p><a class="btn btn--outline" href="/admin/sources">จัดการแหล่งข่าว</a></div><% } %></div></section></main><%- include("../partials/footer") %>
