<%- include("../partials/head",{metaTitle,noindex:true}) %><main id="main"><section class="dash-hero dash-hero--admin"><div class="container"><div><span class="eyebrow">Sources & AI</span><h1>แหล่งข่าวและ AI</h1><p>RSS, YouTube channel หรือคำค้นหา YouTube ระบบดึงอัตโนมัติตามรอบเวลาของแต่ละแหล่ง</p></div><form method="post" action="/admin/sources/fetch-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--gold">ดึงทุกแหล่งตอนนี้</button></form></div></section><%- include("../partials/admin-nav") %><section class="section section--tight"><div class="container"><%- include("_ai-status",{worker}) %><div class="table-wrap"><table class="sources-table"><thead><tr><th>แหล่งข่าว</th><th>หมวด</th><th>ตั้งค่า</th><th>สถานะล่าสุด</th><th>จัดการ</th></tr></thead><tbody><% sources.forEach(s=>{ %><tr class="<%= s.active?'':'is-off' %>"><td><strong><%= s.name %></strong><small><%= sourceTypes[s.type]||s.type %></small><small class="url"><%= s.url %></small><% if(s.keywords){ %><small>กรองคำ: <%= s.keywords %></small><% } %><% if(s.note){ %><small class="muted"><%= s.note %></small><% } %></td><td><%= newsKinds[s.kind]?newsKinds[s.kind].short:s.kind %><small><%= s.item_count %> รายการ</small></td><td><small><%= s.active?'✅ เปิด':'⏸ ปิด' %></small><small><%= s.auto_ai?'🤖 AI เขียนอัตโนมัติ':'✋ เลือกเอง' %></small><small>ทุก <%= s.interval_min>=60?(s.interval_min/60)+' ชม.':s.interval_min+' นาที' %></small></td><td><small><%= s.last_fetched_at?ago(s.last_fetched_at):'ยังไม่เคยดึง' %></small><small class="<%= s.last_status==='error'?'error-text':'' %>"><%= s.last_status==='error'?'⚠ '+s.last_error:s.last_status %></small></td><td><div class="admin-actions"><form method="post" action="/admin/sources/<%= s.id %>/fetch"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>ดึงตอนนี้</button></form><form method="post" action="/admin/sources/<%= s.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="<%= s.active?'0':'1' %>"><button><%= s.active?'ปิด':'เปิด' %></button></form><form method="post" action="/admin/sources/<%= s.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="auto_ai" value="<%= s.auto_ai?'0':'1' %>"><button><%= s.auto_ai?'ปิด AI อัตโนมัติ':'เปิด AI อัตโนมัติ' %></button></form><details class="edit-source"><summary>แก้ไข</summary><form method="post" action="/admin/sources/<%= s.id %>/update" class="mini-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="<%= s.active %>"><input type="hidden" name="auto_ai" value="<%= s.auto_ai %>"><label>ชื่อ<input name="name" value="<%= s.name %>"></label><label>URL / คำค้น<input name="url" value="<%= s.url %>"></label><label>กรองคำ (คั่นด้วย ,)<input name="keywords" value="<%= s.keywords %>"></label><label>ดึงทุก (นาที)<input name="interval_min" type="number" min="30" value="<%= s.interval_min %>"></label><label>หมวด<select name="kind"><% Object.entries(newsKinds).forEach(([k,v])=>{ %><option value="<%= k %>" <%= s.kind===k?'selected':'' %>><%= v.label %></option><% }) %></select></label><label>หมายเหตุ<input name="note" value="<%= s.note %>"></label><button class="btn btn--primary btn--sm">บันทึก</button></form></details><form method="post" action="/admin/sources/<%= s.id %>/delete" data-confirm="ลบแหล่งข่าวนี้และรายการดิบทั้งหมดของแหล่งนี้?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="red">ลบ</button></form></div></td></tr><% }) %></tbody></table></div><div class="form-card source-form"><h2>เพิ่มแหล่งข่าว</h2><%- include("../partials/errors",{errors}) %><form method="post" action="/admin/sources" class="fields"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>ชื่อแหล่งข่าว<input name="name" required value="<%= form.name||'' %>" placeholder="เช่น ช่อง YouTube XYZ"></label><label>ประเภท<select name="type"><% Object.entries(sourceTypes).forEach(([k,v])=>{ %><option value="<%= k %>" <%= form.type===k?'selected':'' %>><%= v %></option><% }) %></select></label><label class="full">URL ของ RSS / ลิงก์ช่อง YouTube / @handle / คำค้นหา<input name="url" required value="<%= form.url||'' %>" placeholder="https://... หรือ @channelname หรือ คำค้น"></label><label>หมวด<select name="kind"><% Object.entries(newsKinds).forEach(([k,v])=>{ %><option value="<%= k %>" <%= form.kind===k?'selected':'' %>><%= v.label %></option><% }) %></select></label><label>ดึงทุก (นาที)<input name="interval_min" type="number" min="30" value="<%= form.interval_min||360 %>"></label><label class="full">กรองเฉพาะรายการที่มีคำเหล่านี้ (ไม่บังคับ คั่นด้วย ,)<input name="keywords" value="<%= form.keywords||'' %>" placeholder="เช่น เกม,Unity,Godot"></label><label class="check"><input type="checkbox" name="active" value="1" <%= form.active?'checked':'' %>> เปิดใช้งาน</label><label class="check"><input type="checkbox" name="auto_ai" value="1" <%= form.auto_ai?'checked':'' %>> ให้ AI เขียนทุกรายการใหม่อัตโนมัติ (เหมาะกับแหล่งที่โพสต์ไม่บ่อย)</label><label class="full">หมายเหตุ<input name="note" value="<%= form.note||'' %>"></label><button class="btn btn--gold">เพิ่มแหล่งข่าว</button></form><div class="help-box"><h3>ตัวอย่างแหล่งที่ใช้ได้</h3><ul><li><strong>itch.io ตามแท็ก:</strong> https://itch.io/games/newest/tag-thailand.xml (เปลี่ยน thailand เป็นแท็กอื่นได้)</li><li><strong>ช่อง YouTube:</strong> วางลิงก์ช่อง เช่น https://www.youtube.com/@channel หรือ channel ID ที่ขึ้นต้นด้วย UC ไม่ต้องใช้ API key</li><li><strong>Playlist YouTube:</strong> วางลิงก์ที่มี ?list=... เลือกประเภท YouTube channel</li><li><strong>ค้นหา YouTube ด้วยคำ:</strong> <%= youtubeKey?'✅ ตั้ง YOUTUBE_API_KEY แล้ว':'⚠ ต้องตั้ง YOUTUBE_API_KEY ใน Coolify ก่อน' %></li><li><strong>เว็บข่าว/บล็อกทั่วไป:</strong> ส่วนใหญ่มี /feed หรือ /rss.xml</li><li><strong>Udemy:</strong> ไม่มี API/RSS ให้แล้ว ใช้เมนู “เพิ่มลิงก์ / คอร์ส” วางลิงก์คอร์สทีละคอร์สแทน</li></ul></div></div></div></section></main><%- include("../partials/footer") %>
