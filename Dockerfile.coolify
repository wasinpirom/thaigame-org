# ThaiGame.org + AI เขียนข่าว (Qwen2.5 7B ในตัว) – วางใน Coolify (+ New → Dockerfile) แล้ว Deploy ได้เลย
FROM ollama/ollama:latest AS ollama
RUN rm -rf /usr/lib/ollama/cuda* /usr/lib/ollama/rocm* /usr/lib/ollama/vulkan* /usr/lib/ollama/mlx* || true

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3000 STORAGE_DIR=/app/storage \
    EMBEDDED_OLLAMA=true OLLAMA_MODELS=/app/storage/ollama LLM_MODEL=qwen2.5:7b
COPY --from=ollama /usr/bin/ollama /usr/bin/ollama
COPY --from=ollama /usr/lib/ollama /usr/lib/ollama
WORKDIR /app
ADD --keep-git-dir=false https://github.com/wasinpirom/thaigame-org.git#main /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libgomp1 python3 make g++ \
 && npm ci --omit=dev && npm cache clean --force \
 && apt-get purge -y python3 make g++ && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /app/storage && chown -R node:node /app
USER node
EXPOSE 3000
VOLUME ["/app/storage"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "src/server.js"]
